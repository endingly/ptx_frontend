{
    "version": 8,
    "configurePresets": [
        {
            "name": "ci-linux-gcc-debug",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++",
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON",
                "PTX_FRONTEND_BUILD_CONSUMER_TESTS": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "ci-linux-gcc-release",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++",
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTING": "ON",
                "PTX_FRONTEND_BUILD_CONSUMER_TESTS": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "ci-consumer-integration",
            "inherits": "ci-linux-gcc-debug",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "PTX_FRONTEND_BUILD_CONSUMER_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ci-linux-gcc-debug",
            "configurePreset": "ci-linux-gcc-debug",
            "configuration": "Debug"
        },
        {
            "name": "ci-linux-gcc-release",
            "configurePreset": "ci-linux-gcc-release",
            "configuration": "Release"
        },
        {
            "name": "ci-consumer-integration",
            "configurePreset": "ci-consumer-integration",
            "configuration": "Debug",
            "targets": ["ptx_frontend_resolved_ir", "test_modern_operand_codegen"]
        }
    ],
    "testPresets": [
        {
            "name": "ci-linux-gcc-debug",
            "configurePreset": "ci-linux-gcc-debug",
            "configuration": "Debug",
            "filter": {
                "exclude": {
                    "name": "^python_test$"
                }
            }
        },
        {
            "name": "ci-linux-gcc-release",
            "configurePreset": "ci-linux-gcc-release",
            "configuration": "Release",
            "filter": {
                "exclude": {
                    "name": "^python_test$"
                }
            }
        },
        {
            "name": "ci-consumer-integration",
            "configurePreset": "ci-consumer-integration",
            "configuration": "Debug",
            "filter": {
                "include": {
                    "label": "consumer"
                }
            },
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "error"
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "ci-linux-gcc-debug",
            "displayName": "CI Debug Build + Test",
            "description": "Configure, build Debug, run tests",
            "steps": [
                {
                    "name": "ci-linux-gcc-debug",
                    "type": "configure"
                },
                {
                    "name": "ci-linux-gcc-debug",
                    "type": "build"
                },
                {
                    "name": "ci-linux-gcc-debug",
                    "type": "test"
                }
            ]
        },
        {
            "name": "ci-linux-gcc-release",
            "displayName": "CI Release Build + Test",
            "description": "Configure, build Release, run tests",
            "steps": [
                {
                    "name": "ci-linux-gcc-release",
                    "type": "configure"
                },
                {
                    "name": "ci-linux-gcc-release",
                    "type": "build"
                },
                {
                    "name": "ci-linux-gcc-release",
                    "type": "test"
                }
            ]
        },
        {
            "name": "ci-consumer-integration",
            "displayName": "Consumer and integration coverage",
            "description": "Build opt-in consumer fixtures and run their labeled CTest coverage",
            "steps": [
                {
                    "name": "ci-consumer-integration",
                    "type": "configure"
                },
                {
                    "name": "ci-consumer-integration",
                    "type": "build"
                },
                {
                    "name": "ci-consumer-integration",
                    "type": "test"
                }
            ]
        }
    ]
}
