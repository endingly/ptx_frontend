# Makefile generators do not rebuild a stamp when only a BYPRODUCT disappears.
# A missing file calls for a complete emission before refreshing stamps.
# Preflight defers finalization to the global edge; the target check finalizes
# only after its deferred emission succeeds.
set(_expected_outputs "@resolved_generated_outputs@")
set(_codegen_command "@resolved_codegen_base_command@")
set(_codegen_jobs "@PTX_FRONTEND_CODEGEN_JOBS@")
set(_category_stamps "@resolved_category_stamps@")
set(_global_stamp "@resolved_global_stamp@")

foreach(_output IN LISTS _expected_outputs)
    if(NOT EXISTS "${_output}")
        if(PTX_REPAIR_FINALIZE)
            # A later finalizer failure must leave the global edge dirty even
            # after deferred emission has restored every missing byproduct.
            file(REMOVE "${_global_stamp}")
        endif()
        execute_process(
            COMMAND ${_codegen_command} --defer-finalization
                --jobs "${_codegen_jobs}"
            RESULT_VARIABLE _result)
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "Failed to repair missing generated outputs")
        endif()
        if(PTX_REPAIR_FINALIZE)
            execute_process(
                COMMAND ${_codegen_command} --global-artifacts
                    --jobs "${_codegen_jobs}"
                RESULT_VARIABLE _result)
            if(NOT _result EQUAL 0)
                message(FATAL_ERROR "Failed to finalize repaired outputs")
            endif()
            file(TOUCH ${_category_stamps} "${_global_stamp}")
        else()
            file(TOUCH ${_category_stamps})
        endif()
        break()
    endif()
endforeach()
