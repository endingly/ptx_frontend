# CMake's aggregate edge owns every generated byproduct. This runner uses
# per-category completion stamps only to choose work within one Python process.
# Makefile targets also call it to recover missing byproducts of a clean edge.
set(_description_file "@resolved_build_description_file@")
set(_binary_dir "@CMAKE_CURRENT_BINARY_DIR@")
set(_spec_files "@resolved_spec_files@")
set(_spec_membership "@resolved_spec_inputs_manifest@")
set(_shared_inputs "@resolved_shared_codegen_inputs@")
set(_codegen_command "@resolved_codegen_base_command@")
set(_jobs "@PTX_FRONTEND_CODEGEN_JOBS@")
set(_global_stamp "@resolved_global_stamp@")
set(_aggregate_stamp "@resolved_aggregate_stamp@")
set(_manifest "@resolved_output_manifest@")

# CMake's IS_NEWER_THAN deliberately reports equal mtimes as newer. Comparing
# the fixed-width microsecond timestamps keeps an immediate no-op build clean.
function(_ptx_inputs_newer_than_stamp result stamp)
    if(NOT EXISTS "${stamp}")
        set(${result} TRUE PARENT_SCOPE)
        return()
    endif()
    file(TIMESTAMP "${stamp}" stamp_time "%s%f" UTC)
    foreach(input IN LISTS ARGN)
        if(NOT EXISTS "${input}")
            message(FATAL_ERROR "Missing resolved IR generator input: ${input}")
        endif()
        file(TIMESTAMP "${input}" input_time "%s%f" UTC)
        if(input_time STRGREATER stamp_time)
            set(${result} TRUE PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${result} FALSE PARENT_SCOPE)
endfunction()

function(_ptx_json_array result description)
    string(JSON item_count LENGTH "${description}" ${ARGN})
    set(items)
    if(item_count GREATER 0)
        math(EXPR last_item "${item_count} - 1")
        foreach(item_index RANGE 0 ${last_item})
            string(JSON item GET "${description}" ${ARGN} ${item_index})
            list(APPEND items "${item}")
        endforeach()
    endif()
    set(${result} "${items}" PARENT_SCOPE)
endfunction()

file(READ "${_description_file}" _description)
string(JSON _category_count LENGTH "${_description}" categories)
if(_category_count EQUAL 0)
    message(FATAL_ERROR "Resolved IR build description has no categories")
endif()
math(EXPR _last_category "${_category_count} - 1")
set(_dirty_categories)
set(_dirty_category_stamps)
foreach(index RANGE 0 ${_last_category})
    string(JSON category GET "${_description}" categories ${index} name)
    _ptx_json_array(category_specs "${_description}"
        categories ${index} spec_files)
    _ptx_json_array(category_outputs "${_description}"
        categories ${index} outputs)
    set(category_membership "${_binary_dir}/resolved_codegen_${category}_inputs.txt")
    set(category_stamp "${_binary_dir}/resolved_codegen_${category}.stamp")
    _ptx_inputs_newer_than_stamp(category_dirty "${category_stamp}"
        ${category_specs} "${category_membership}" ${_shared_inputs})
    foreach(output IN LISTS category_outputs)
        if(NOT EXISTS "${output}")
            set(category_dirty TRUE)
        endif()
    endforeach()
    if(category_dirty)
        list(APPEND _dirty_categories "${category}")
        list(APPEND _dirty_category_stamps "${category_stamp}")
    endif()
endforeach()

_ptx_json_array(_global_outputs "${_description}" global_outputs)
_ptx_inputs_newer_than_stamp(_global_dirty "${_global_stamp}"
    ${_spec_files} "${_spec_membership}" ${_shared_inputs})
foreach(output IN LISTS _global_outputs)
    if(NOT EXISTS "${output}")
        set(_global_dirty TRUE)
    endif()
endforeach()
if(_dirty_categories OR NOT EXISTS "${_manifest}"
        OR NOT EXISTS "${_aggregate_stamp}")
    set(_global_dirty TRUE)
endif()

if(NOT _dirty_categories AND NOT _global_dirty)
    # A command-line/configuration-only edge change needs one successful
    # completion update, otherwise Ninja schedules this edge on every build.
    if(PTX_ACKNOWLEDGE_EDGE)
        file(TOUCH "${_aggregate_stamp}")
    endif()
    return()
endif()

# Any interrupted or failed emission leaves every selected marker absent.
# Even a repaired output that exists after a later failure remains dirty.
file(REMOVE "${_aggregate_stamp}" ${_dirty_category_stamps})
set(_batch_options --incremental-batch)
foreach(category IN LISTS _dirty_categories)
    list(APPEND _batch_options --batch-category "${category}")
endforeach()
if(_global_dirty)
    file(REMOVE "${_global_stamp}")
    list(APPEND _batch_options --batch-global)
endif()
message(STATUS "Resolved IR batch: categories [${_dirty_categories}], global ${_global_dirty}")
execute_process(
    COMMAND ${_codegen_command} ${_batch_options} --jobs "${_jobs}"
    RESULT_VARIABLE _result)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Resolved IR batch generation failed: ${_result}")
endif()

if(_dirty_category_stamps)
    file(TOUCH ${_dirty_category_stamps})
endif()
if(_global_dirty)
    file(TOUCH "${_global_stamp}")
endif()
file(TOUCH "${_aggregate_stamp}")
