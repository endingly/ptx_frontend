.version 9.3
.target sm_80
.address_size 64

.global .align 4 .u32 global_value;
.shared .align 4 .u32 shared_value;
.shared .align 2 .b16 shared_matrix;

.visible .entry m10_advanced_kernel() {
  .reg .u64 %rd<2>;
  .reg .u32 %r<3>;
  .reg .b32 %b<3>;
  .reg .pred %p<2>;
  .reg .b32 %m<2>;
  .reg .f32 %d<4>;
  .reg .f32 %c<4>;
  .reg .f16x2 %a<2>;
  .reg .f16x2 %h<1>;

  ld.global.L1::evict_first.u32 %r0, [%rd0];
  ld.global.L1::evict_last.u32 %r1, [%rd0];
  st.global.L1::evict_first.u32 [%rd0], %r0;
  st.global.L1::evict_last.u32 [%rd0], %r1;
  ld.global.L2::cache_hint.u32 %r2, [%rd0], %rd1;
  st.global.L2::cache_hint.u32 [%rd0], %r2, %rd1;
  ld.global.relaxed.cta.u32 %r0, [global_value];
  st.global.relaxed.cta.u32 [global_value], %r0;
  ldu.global.u32 %rd0, [global_value];
  prefetch.global.L1 [global_value];
  membar.cta;
  fence.acq_rel.cta;
  atom.global.relaxed.cta.add.u32 %r0, [global_value], %r1;
  red.global.relaxed.cta.add.u32 [global_value], %r0;
  activemask.b32 %b0;
  vote.sync.ballot.b32 %b1, %p0, 0xffffffff;
  shfl.sync.idx.b32 %b2|%p1, %b1, 0, 31, 0xffffffff;
  cp.async.ca.shared.global [shared_value], [global_value], 16;
  cp.async.commit_group;
  cp.async.wait_group 0;
  cp.async.wait_all;
  ldmatrix.sync.aligned.m8n8.x2.shared.b16 {%m0, %m1}, [shared_matrix];
  mma.sync.aligned.m16n8k8.row.col.f32.f16.f16.f32 {%d0, %d1, %d2, %d3}, {%a0, %a1}, {%h0}, {%c0, %c1, %c2, %c3};
}
