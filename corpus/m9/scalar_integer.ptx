.version 9.3
.target sm_80
.address_size 64

.visible .global .align 4 .u32 m9_integer_out;

.visible .entry m9_scalar_integer() {
  .reg .pred %p<2>;
  .reg .u32 %r<13>;
  .reg .s32 %s<1>;

  mov.u32 %r0, 240;
  mov.u32 %r1, 15;
  and.b32 %r2, %r0, %r1;
  or.b32 %r3, %r0, %r1;
  xor.b32 %r4, %r0, %r1;
  not.b32 %r5, %r0;
  shl.b32 %r6, %r0, 4;
  shr.u32 %r7, %r6, 8;
  setp.lt.u32 %p1, %r7, 16;
  setp.lt.and.u32 %p0, %r7, 16, %p1;
  selp.u32 %r8, %r3, %r2, %p0;
  cvt.s32.u32 %s0, %r8;
  mul.lo.u32 %r10, %r8, 4;
  mad.lo.u32 %r11, %r10, 1, 2;
  div.u32 %r12, %r11, 2;
  st.global.u32 [m9_integer_out], %r12;
  exit;
}
