.version 9.3
.target sm_100
.address_size 64
.visible .entry probe(.param .u64 output) {
 .reg .b64 %out;
 .reg .b8 %v;
 .shared .align 16 .b8 slot[16];
 .local .align 16 .b8 loc[16];
 ld.param.u64 %out, [output];
 ld.global.b8 %v, [%out];
 st.shared.b8 [slot], 0;
 ld.shared.b8 %v, [slot];
 st.global.b8 [%out], %v;
 ret;
}
