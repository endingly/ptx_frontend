.version 9.3
.target sm_100
.address_size 64
.visible .entry probe(.param .u64 output) {
 .reg .b64 %out;
 .reg .f64 %v;
 .shared .align 16 .b8 slot[16];
 .local .align 16 .b8 loc[16];
 ld.param.u64 %out, [output];
 ld.global.f64 %v, [%out];
 st.shared.f64 [slot], 0d3ff8000000000000;
 ld.shared.f64 %v, [slot];
 st.global.f64 [%out], %v;
 ret;
}
