.version 9.3
.target sm_100
.address_size 64
.visible .entry probe(.param .u64 output) {
 .reg .b64 %out;
 .reg .s32 %v;
 .shared .align 16 .b8 slot[16];
 .local .align 16 .b8 loc[16];
 ld.param.u64 %out, [output];
 ld.global.s32 %v, [%out];
 st.shared.s32 [slot], -2147483649;
 ld.shared.s32 %v, [slot];
 st.global.s32 [%out], %v;
 ret;
}
