.version 9.3
.target sm_100
.address_size 64

.visible .entry probe(.param .u64 output) {
.reg .b64 %out, %policy;
.reg .b32 %v;
.shared .align 16 .b8 slot[16];
ld.param.u64 %out, [output];
ld.global.b32 %v, [%out];
ld.global.b64 %policy, [%out];
st.shared::cta.b32 [slot], %v;
ld.shared.b32 %v,[slot];
st.global.b32 [%out],%v;
ret;
}
