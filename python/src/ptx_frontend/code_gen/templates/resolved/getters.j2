{% for domain in model.domains %}/** Return one stable contiguous {{ domain.name }} catalog in canonical form order. */
const {{ domain.root_type }}& {{ model.prefix }}_{{ domain.name }}_descriptor() noexcept {
  static_assert(std::is_trivially_copyable_v<{{ domain.type_name }}>);
  static const std::array<{{ domain.type_name }}, {{ model.count }}> variants = []() noexcept {
    std::array<{{ domain.type_name }}, {{ model.count }}> ordered{};
    size_t next = 0;
    for (auto shard : std::array<std::span<const {{ domain.type_name }}>, {{ model.shard_indices | length }}>{{ '{{' }}
{% for index in model.shard_indices %}        generated_detail::{{ model.prefix }}_{{ domain.name }}_variants_{{ index }}(){% if not loop.last %},
{% endif %}{% endfor %}
    {{ '}}' }}) {
      for (const auto& row : shard) {
        assert(next < ordered.size());
        ordered[next++] = row;
      }
    }
    assert(next == ordered.size());
    return ordered;
  }();
  static const {{ domain.root_type }} descriptor{
      .{{ domain.opcode_member }} = "{{ model.opcode }}", .variants = variants};
  return descriptor;
}{% if not loop.last %}

