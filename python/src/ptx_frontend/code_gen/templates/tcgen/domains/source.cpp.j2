  check_fixed(word.bits, table, report);
  const auto decoded = decode_tcgen_zero_column(word);
  if (!context.m) need(report, TcgenDescriptorObligation::ZeroM);
  if (!context.n) need(report, TcgenDescriptorObligation::ZeroN);
  const bool supported_m = !context.m ||
      std::any_of(kPartitions.begin(), kPartitions.end(),
                  [&context](const auto& row) { return row.first == *context.m; });
