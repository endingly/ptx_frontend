{% endmacro %}{% macro scaled_target_accept(model) %}/** Check a supplied target identity and version against the closed rows. */
bool {{ model.target_checker }}(const {{ model.cpp_prefix }}KnownFacts& facts) {
  const auto profile = base::find_target_profile(facts.target->source_spelling);
  if (!profile || profile->identity != *facts.target) return false;
  for (const auto& gate : {{ model.target_array }}) {
    if (gate.scaled_d != facts.scaled_d ||
        *facts.ptx_version < gate.minimum_ptx) continue;
    const auto exact = base::parse_target_identity(gate.feature);
    if (gate.exact && exact && base::same_target_identity(*facts.target, *exact))
      return true;
    if (!gate.exact &&
        std::find(profile->enabled_family_features.begin(),
                  profile->enabled_family_features.end(), gate.feature) !=
            profile->enabled_family_features.end())
      return true;
  }
  return false;
}
{% endmacro %}{% macro f16_shared_operand(model) %}/** Apply the per-operand 16-bit Table 57 rule after field validation. */
void {{ model.shared_checker }}(bool is_a, bool transpose,
                          TcgenSharedWord word, TcgenSharedContext context,
                          const {{ model.cpp_prefix }}KnownFacts& facts,
                          {{ model.cpp_prefix }}OperationalReport& report) {
  const auto context_profile = context.target
      ? base::find_target_profile(context.target->source_spelling) : std::nullopt;
  if (context.target &&
      (!context_profile || context_profile->identity != *context.target ||
       (facts.target && !base::same_target_identity(*context.target, *facts.target))))
    report.violations.push_back({{ model.cpp_prefix }}Violation::InvalidContext);
  if (context.ptx_version && facts.ptx_version &&
      *context.ptx_version != *facts.ptx_version)
    report.violations.push_back({{ model.cpp_prefix }}Violation::InvalidContext);
  if (!context.target) context.target = facts.target;
  if (!context.ptx_version) context.ptx_version = facts.ptx_version;
  if (is_a) context.transpose_a = transpose;
  else context.transpose_b = transpose;
  auto fields = validate_tcgen_shared_defined_fields(word, context);
  if (is_a) {
    report.a_shared_fields = std::move(fields);
    report.checked.push_back({{ model.cpp_prefix }}Checked::ASharedFields);
  } else {
    report.b_shared_fields = std::move(fields);
    report.checked.push_back({{ model.cpp_prefix }}Checked::BSharedFields);
  }
  if (!context.major) {
    report.missing.push_back(is_a ? {{ model.cpp_prefix }}Obligation::AMajor
                                  : {{ model.cpp_prefix }}Obligation::BMajor);
  } else {
    if (*context.major != (transpose ? TcgenMajor::MN : TcgenMajor::K))
      report.violations.push_back(is_a ? {{ model.cpp_prefix }}Violation::AMajor
                                        : {{ model.cpp_prefix }}Violation::BMajor);
    report.checked.push_back(is_a ? {{ model.cpp_prefix }}Checked::AMajor
                                  : {{ model.cpp_prefix }}Checked::BMajor);
  }
  const auto decoded = decode_tcgen_shared(word);
  if (!decoded.swizzle ||
      (transpose && *decoded.swizzle == TcgenSwizzle::B128Atom32))
    report.violations.push_back(is_a ? {{ model.cpp_prefix }}Violation::ASwizzle
                                      : {{ model.cpp_prefix }}Violation::BSwizzle);
  report.checked.push_back(is_a ? {{ model.cpp_prefix }}Checked::ASwizzle
                                : {{ model.cpp_prefix }}Checked::BSwizzle);
}
}  // namespace

{% endmacro %}{% macro operation_start(model) %}{{ model.cpp_prefix }}OperationalReport check_{{ model.snake }}_known_operation(
    const {{ model.cpp_prefix }}KnownFacts& facts) {
  {{ model.cpp_prefix }}OperationalReport report;
  report.instruction_fields =
      validate_tcgen_instruction_defined_fields(facts.instruction);
  report.checked.push_back({{ model.cpp_prefix }}Checked::InstructionFields);
  if (facts.instruction.kind != TcgenMmaKind::{{ model.kind }}) {
    report.violations.push_back({{ model.cpp_prefix }}Violation::Kind);
    return report;
  }
  if (facts.group != TcgenCtaGroup::One && facts.group != TcgenCtaGroup::Two) {
    report.violations.push_back({{ model.cpp_prefix }}Violation::Group);
    return report;
  }
{% endmacro %}{% macro shared_placement(model) %}  if (facts.a_in_tmem) {
    if (facts.a_shared_word)
      report.violations.push_back({{ model.cpp_prefix }}Violation::APlacementFacts);
  } else if (!facts.a_shared_word) {
    report.missing.push_back({{ model.cpp_prefix }}Obligation::ASharedWord);
  } else {
    {{ model.shared_checker }}(true, decoded.transpose_a, *facts.a_shared_word,
                         facts.a_context, facts, report);
  }
  if (!facts.b_shared_word) {
    report.missing.push_back({{ model.cpp_prefix }}Obligation::BSharedWord);
  } else {
    {{ model.shared_checker }}(false, decoded.transpose_b, *facts.b_shared_word,
                         facts.b_context, facts, report);
  }
{% endmacro %}{% macro datapath(model) %}  for (const auto& row : {{ model.path_array }}) {
    if (row.group != facts.group || row.m != decoded.m) continue;
    report.path_layout = row.layout;
    report.checked.push_back({{ model.cpp_prefix }}Checked::Datapath);
    const auto allowed = [&row](uint8_t lane) {
      return std::find(row.allowed_lane_halves.begin(),
                       row.allowed_lane_halves.begin() + row.allowed_lane_count,
                       lane) != row.allowed_lane_halves.begin() +
                                   row.allowed_lane_count;
    };
    if (facts.a_in_tmem) {
      if (!facts.a_lane_half)
        report.missing.push_back({{ model.cpp_prefix }}Obligation::ALaneHalf);
      else if (!allowed(*facts.a_lane_half))
        report.violations.push_back({{ model.cpp_prefix }}Violation::ALaneHalf);
    }
    if (!facts.d_lane_half)
      report.missing.push_back({{ model.cpp_prefix }}Obligation::DLaneHalf);
    else if (!allowed(*facts.d_lane_half))
      report.violations.push_back({{ model.cpp_prefix }}Violation::DLaneHalf);
    if (row.half_path && facts.a_in_tmem && facts.a_lane_half &&
        facts.d_lane_half && allowed(*facts.a_lane_half) &&
        allowed(*facts.d_lane_half)) {
      if (*facts.a_lane_half != *facts.d_lane_half)
        report.violations.push_back({{ model.cpp_prefix }}Violation::HalfAlignment);
      report.checked.push_back({{ model.cpp_prefix }}Checked::HalfAlignment);
    }
    break;
  }
{% endmacro %}{% macro operation_finish(model) %}  if (!facts.target || !facts.ptx_version)
    report.missing.push_back({{ model.cpp_prefix }}Obligation::Target);
  else {
    if (!{{ model.target_checker }}(facts))
      report.violations.push_back({{ model.cpp_prefix }}Violation::Target);
    report.checked.push_back({{ model.cpp_prefix }}Checked::Target);
  }
  return report;
}
