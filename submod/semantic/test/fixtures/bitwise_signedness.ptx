.version 9.1
.target sm_80
.address_size 64

.visible .global .align 8 .u64 bitwise_results[8] = {
    ((-1 & -1) < 0),
    ((-1 | 0) < 0),
    ((-1 ^ 0) < 0),
    ((-4 | 0) >> 1),
    (((.s64)(-4 | 0)) >> 1),
    ((-1 & -1U) < 0),
    ((~0) < 0),
    ((-1 + 0) < 0)
};

.visible .entry bitwise_probe() {
    ret;
}
